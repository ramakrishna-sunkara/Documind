# EditorConfig for DocuMind
# https://editorconfig.org

root = true

# Default settings for all files
[*]
charset = utf-8
end_of_line = lf
indent_style = space
indent_size = 4
insert_final_newline = true
trim_trailing_whitespace = true
max_line_length = 120

# Kotlin files
[*.{kt,kts}]
indent_size = 4
max_line_length = 120
ij_kotlin_imports_layout = *,java.**,javax.**,kotlin.**,kotlinx.**,^
ij_kotlin_allow_trailing_comma = true
ij_kotlin_allow_trailing_comma_on_call_site = true

# ktlint specific settings
ktlint_code_style = android_studio
ktlint_standard_no-wildcard-imports = disabled
ktlint_standard_package-name = disabled

# Java files
[*.java]
indent_size = 4
max_line_length = 120

# XML files (Android layouts, resources)
[*.xml]
indent_size = 4

# Gradle files
[*.gradle]
indent_size = 4

[*.gradle.kts]
indent_size = 4

# JSON files
[*.json]
indent_size = 2

# YAML files
[*.{yml,yaml}]
indent_size = 2

# Markdown files
[*.md]
trim_trailing_whitespace = false
max_line_length = off

# Properties files
[*.properties]
charset = latin1

# Shell scripts
[*.sh]
indent_size = 2
end_of_line = lf

# Batch files
[*.bat]
end_of_line = crlf

# Makefiles
[Makefile]
indent_style = tab

# ProGuard files
[{proguard-rules.pro,consumer-rules.pro}]
indent_size = 4
